# Multi-stage build: Build both NestJS and Go applications into one container

# ============================================================================
# Stage 1: Database Migration & Build NestJS Core Application
# ============================================================================
FROM node:20-alpine AS nestjs-builder

WORKDIR /app/core

# Install dependencies for building
RUN apk add --no-cache python3 make g++ ca-certificates postgresql-client

# Copy package files
COPY core/package*.json ./

# Install dependencies (including devDependencies for typeorm CLI)
RUN npm ci

# Copy source code
COPY core/ .

# Copy typeorm config
COPY core/typeorm.config.js ./

# ============================================================================
# Run Database Migration
# ============================================================================
RUN mkdir -p migrations && \
    echo "✓ Migrations directory prepared for runtime generation"

# ============================================================================
# Build Applications (Secure Build)
# ============================================================================
# First build with TSC to get separate entity files, generate migrations, then build with webpack and obfuscate
RUN echo "🔨 Building with TypeScript compiler for migration generation..." && \
    npm run build:tsc && \
    echo "✓ TSC build completed" && \
    echo "🔍 Checking dist folder contents..." && \
    ls -la dist/ && \
    find dist/ -name "*.entity.js" | head -10 && \
    echo "📦 Generating migrations from entity files..." && \
    node ./generate-migrations.js && \
    echo "✓ Migrations generated successfully" && \
    echo "🔍 Checking generated migrations..." && \
    ls -la migrations/ && \
    echo "🔨 Building final application with webpack..." && \
    npm run build && \
    echo "✓ Webpack build completed" && \
    echo "🔐 Obfuscating application..." && \
    node obfuscate.js && \
    echo "✓ Obfuscation completed"

# ============================================================================
# Stage 2: Build Go CV Assessor Application
# ============================================================================
FROM golang:1.24.10-alpine AS go-builder

WORKDIR /app/cv_assessor

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Copy go mod files
COPY cv_assessor/go.mod cv_assessor/go.sum* ./

# Download dependencies
RUN go mod download

# Copy source code
COPY cv_assessor/ .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o cv_assessor .

# ============================================================================
# Stage 3: Runtime Container
# ============================================================================
FROM node:20-alpine

# Install runtime dependencies
RUN apk update && apk add --no-cache ca-certificates tzdata curl bash postgresql-client

# Create app user for security
RUN addgroup -g 1001 appuser && \
    adduser -D -u 1001 -G appuser appuser

# Set working directories
WORKDIR /home/appuser

# Create directories for both services (including migrations mountpoint)
RUN mkdir -p core/migrations core/uploads cv_assessor && \
    chown -R appuser:appuser /home/appuser

# Copy NestJS Application Files
COPY --from=nestjs-builder --chown=appuser:appuser /app/core/dist ./core/dist
COPY --from=nestjs-builder --chown=appuser:appuser /app/core/node_modules ./core/node_modules
COPY --from=nestjs-builder --chown=appuser:appuser /app/core/package*.json ./core/
COPY --from=nestjs-builder --chown=appuser:appuser /app/core/generate-migrations.js ./core/
COPY --from=nestjs-builder --chown=appuser:appuser /app/core/migrations ./core/migrations
COPY --chown=appuser:appuser core/typeorm.config.js ./core/

# Remove any stray generated migration that may sneak into the image (e.g. init.js)
RUN rm -f ./core/migrations/init.js || true

# ============================================================================
# Copy Go Application Files
# ============================================================================
COPY --from=go-builder --chown=appuser:appuser /app/cv_assessor/cv_assessor ./cv_assessor/

# Copy entrypoint script
COPY --chown=appuser:appuser ./docker-startup.sh ./docker-startup.sh

# Make scripts executable
RUN chmod +x ./docker-startup.sh

# Switch to non-root user
USER appuser

# Expose ports
EXPOSE 5400 5500

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:5400/healthcheck || curl -f http://localhost:5500/healthcheck || exit 1

# Run both applications
ENTRYPOINT ["/bin/bash"]
CMD ["/home/appuser/docker-startup.sh"]
