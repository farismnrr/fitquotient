CORE_HOST=0.0.0.0
CORE_PORT=5400

# LOG_LEVEL possible values: error, warn, info, debug
LOG_LEVEL=debug

# API Configuration
CORE_API_KEY=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRATION=3600

# SQLite Configuration (default)
CORE_DB_PATH=./database.sqlite

# PostgreSQL Configuration (uncomment and fill if you want to use PostgreSQL)
# CORE_DB_TYPE=postgres
# CORE_DB_HOST=localhost
# CORE_DB_PORT=5432
# CORE_DB_USER=postgres
# CORE_DB_PASS=postgres
# CORE_DB_NAME=postgres

# MySQL Configuration (uncomment and fill if you want to use MySQL)
# CORE_DB_TYPE=mysql
# CORE_DB_HOST=localhost
# CORE_DB_PORT=3306
# CORE_DB_USER=root
# CORE_DB_PASS=
# CORE_DB_NAME=mysql

# Redis Configuration (optional - uncomment and fill if you want to use Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

# Timezone Configuration
# Format: +HH:MM or -HH:MM (e.g., +07:00 for Jakarta/Bangkok)
TZ=+07:00

CV_ASSESSOR_BASE_URL=http://localhost:5500
CV_ASSESSOR_API_KEY=

# CORS origins allowed for the API (comma-separated). Default is localhost for dev.
# Example: CORE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORE_CORS_ORIGINS=http://localhost:3000
