# ==========================================
# FitQuotient Environment Configuration
# ==========================================

# ==========================================
# NestJS Core Service Configuration
# ==========================================
CORE_HOST=
CORE_PORT=

# LOG_LEVEL possible values: error, warn, info, debug
LOG_LEVEL=

# API Configuration
CORE_API_KEY=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRATION=
JWT_REFRESH_EXPIRATION=

# Database Type (sqlite, postgres, mysql)
# CORE_DB_TYPE=

# SQLite Configuration (only if CORE_DB_TYPE=sqlite)
CORE_DB_PATH=

# PostgreSQL Configuration (used in docker-compose)
# CORE_DB_HOST=
# CORE_DB_PORT=
# CORE_DB_USER=
# CORE_DB_PASS=
# CORE_DB_NAME=

# MySQL Configuration (uncomment if CORE_DB_TYPE=mysql)
# CORE_DB_HOST=
# CORE_DB_PORT=
# CORE_DB_USER=
# CORE_DB_PASS=
# CORE_DB_NAME=

# ==========================================
# Go CV Assessor Service Configuration
# ==========================================
CV_ASSESSOR_HOST=
CV_ASSESSOR_PORT=
CV_ASSESSOR_API_KEY=

# CV Assessor Base URL (for core to communicate with cv_assessor)
CV_ASSESSOR_BASE_URL=

# ==========================================
# Redis Configuration (Shared)
# ==========================================
REDIS_HOST=
REDIS_PORT=
REDIS_PASS=

# ==========================================
# Qdrant Vector Database Configuration
# ==========================================
QDRANT_URL=
QDRANT_API_KEY=http://qdrant:6333

# ==========================================
# Timezone Configuration
# ==========================================
# Format: +HH:MM or -HH:MM (e.g., +07:00 for Jakarta/Bangkok)
TZ=

# ==========================================
# Node Environment
# ==========================================
NODE_ENV=

# ==========================================
# Gin Mode (for Go service)
# ==========================================
GIN_MODE=

# ==========================================
# FitQuotient Frontend Configuration
# ==========================================
UI_PORT=
URL_CORE=
NEXT_PUBLIC_URL_CORE=
URL_API_KEY=
